# Contraseña para entrar en la app
APP_PASSWORD=
# Secreto para firmar la cookie de sesión (32+ caracteres aleatorios)
SESSION_SECRET=
# URL pública de la app (para enlaces en Telegram)
APP_URL=https://experto-en-seo.vercel.app
# n8n: base y clave compartida con la credencial "SEO Pasarela" (cabecera X-Seo-Key)
N8N_BASE=https://paneln8n.transformaconia.com
SEO_GATEWAY_KEY=
# Postgres (Supabase ERP PRUEBA, esquema seo) por el pooler en modo transacción
DATABASE_URL=
OPENAI_API_KEY=
WP_BASE=https://transformaconia.com
# Vercel Cron
CRON_SECRET=
# Opcional: clave de Google para PageSpeed Insights (sin ella hay límite de uso)
PAGESPEED_KEY=
